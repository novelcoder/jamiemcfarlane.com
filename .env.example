# Server-only MailerLite Classic API credentials.
MAILERLITE_API_KEY=

# Numeric ID for the Privateer Tales main subscriber group. Do not reuse the
# Mac Worden group ID.
MAILERLITE_PRIVATEER_TALES_GROUP_ID=

# Public GA4 measurement ID. Appwrite must provide this during the build.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only read key for the shared Appwrite catalog and private blog media.
# Grant rows.read and files.read. Never expose this key to the browser.
CATALOG_API_KEY=

# Temporary local-only schema key used by database setup scripts. Never expose
# this key to the browser or configure it on the production Site.
APPWRITE_SCHEMA_API=
