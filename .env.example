# URL of the shared Appwrite newsletter signup function. /api/subscribe proxies
# to it server-side; the function holds the only MailerLite credentials and
# writes the newsletter_signup_events row.
NEWSLETTER_SIGNUP_FUNCTION_URL=

# Public GA4 measurement ID. Appwrite must provide this during the build.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only key for the shared Appwrite catalog, private blog media, and
# anonymous measurement events. Grant rows.read, rows.write, and files.read.
# Never expose this key to the browser.
CATALOG_API_KEY=

# Temporary local-only schema key used by database setup scripts. Never expose
# this key to the browser or configure it on the production Site.
APPWRITE_SCHEMA_API=
